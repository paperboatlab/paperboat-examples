{"flow": {"edges": [{"from": ["seed", "y"], "to": ["drive", "seed"]}, {"from": ["drive", "y"], "to": ["rig-1", "cmd"]}, {"from": ["drive", "y"], "to": ["graph-u", "in"]}, {"from": ["rig-1", "theta"], "to": ["enc-theta", "u"]}, {"from": ["rig-1", "alpha"], "to": ["enc-alpha", "u"]}, {"from": ["enc-theta", "y"], "to": ["d-theta", "u"]}, {"from": ["d-theta", "y"], "to": ["rate-theta", "u"]}, {"from": ["enc-theta", "y"], "to": ["drive", "th"]}, {"from": ["rate-theta", "y"], "to": ["drive", "w"]}, {"from": ["enc-theta", "y"], "to": ["graph-theta", "in"]}, {"from": ["enc-alpha", "y"], "to": ["graph-alpha", "in"]}], "flow": "signal", "nodes": [{"id": "rig-1", "params": {}, "pos": [520, 120], "type": "rig"}, {"id": "seed", "params": {"name": "seed"}, "pos": [0, 200], "type": "variable"}, {"id": "drive", "params": {"f": "4*(0.5235987756*sin(2*pi*(0.2*t + 0.0575*t^2)) - th) - 0.08*w + 2*sign(frac(sin((floor(t/0.15) + 1000*seed)*12.9898)*43758.5453) - 0.5)"}, "pos": [260, 120], "type": "function"}, {"id": "enc-theta", "params": {"interval": 0.0007669903939428206}, "pos": [760, 80], "type": "quantizer"}, {"id": "enc-alpha", "params": {"interval": 0.0007669903939428206}, "pos": [760, 200], "type": "quantizer"}, {"id": "d-theta", "params": {}, "pos": [940, 0], "type": "discrete_derivative"}, {"id": "rate-theta", "params": {"tau": 0.0039788735772973835}, "pos": [1120, 0], "type": "lag"}, {"id": "graph-theta", "params": {}, "pos": [940, 120], "type": "graph"}, {"id": "graph-alpha", "params": {}, "pos": [940, 240], "type": "graph"}, {"id": "graph-u", "params": {}, "pos": [520, 320], "type": "graph"}]}, "overrides": {"objects": {"rig-1": {"props": {"alpha0": 3.141592653589793}}}}, "paperboat": 1, "run": {"dt": 0.002, "duration": 20.0, "solver": "rk4"}, "station": {"name": "furuta-rig", "path": "../stations/furuta-rig", "version": "0.1.0"}, "variables": [{"name": "seed", "type": "number", "value": 1}]}
